# Salin ke .env.local untuk dev; di Vercel isi lewat Project Settings → Environment Variables.
# Semua variabel tanpa prefix NEXT_PUBLIC_ hanya dibaca server dan tidak pernah sampai ke browser.

# Go API (tanpa garis miring di akhir)
API_BASE_URL=https://api-dnd.gewall.my.id
# Sama dengan INTERNAL_API_KEY di .env container API di VPS
INTERNAL_API_KEY=

# Dipakai mulai F2 (auth)
# PEM dari GET /v1/auth/public-key
JWT_PUBLIC_KEY_PEM=
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URL=https://dnd.gewall.my.id/auth/google/callback

# URL publik situs (untuk metadata, sitemap)
NEXT_PUBLIC_SITE_URL=https://dnd.gewall.my.id
