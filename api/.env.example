# Salin ke .env untuk development lokal. Isi secret dengan: go run ./cmd/tools gen-keys
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
PUBLIC_BASE_URL=http://localhost:8080

# DB dev di VPS lewat SSH tunnel: ssh -N -L 5432:127.0.0.1:5432 vps
DATABASE_URL=postgres://dnd_forge_dev:CHANGE_ME@127.0.0.1:5432/dnd_forge_dev
MIGRATE_ON_START=true

INTERNAL_API_KEY=
JWT_PRIVATE_KEY=
JWT_ISSUER=dnd-forge-api
JWT_AUDIENCE=dnd-forge-web
ACCESS_TTL=15m
REFRESH_TTL=720h

ADMIN_EMAILS=admin@example.com

# Opsional: login Google. Kosongkan untuk mematikan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
