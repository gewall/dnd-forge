# Salin ke .env untuk development lokal. Isi secret dengan: go run ./cmd/tools gen-keys
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
PUBLIC_BASE_URL=http://localhost:8080

# DB dev di VPS lewat SSH tunnel: ssh -N -L 5432:127.0.0.1:5432 vps
DATABASE_URL=postgres://dnd_forge_dev:CHANGE_ME@127.0.0.1:5432/dnd_forge_dev
MIGRATE_ON_START=true

INTERNAL_API_KEY=
JWT_PRIVATE_KEY=
JWT_ISSUER=dnd-forge-api
JWT_AUDIENCE=dnd-forge-web
ENCRYPTION_KEY=
ACCESS_TTL=15m
REFRESH_TTL=720h

ADMIN_EMAILS=admin@example.com

# Garage: bucket dev di VPS, key dari ~/apps/dnd-forge-api/garage-key.txt
S3_ENDPOINT=https://s3.gewall.my.id
S3_PUBLIC_ENDPOINT=https://s3.gewall.my.id
S3_REGION=garage
S3_BUCKET=dnd-forge-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PRESIGN_TTL=6h

# Opsional: login Google. Kosongkan untuk mematikan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# AI portrait & lore
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
# job generate yang jalan bersamaan (portrait + lore)
PORTRAIT_WORKERS=1
# true = daftarkan provider "fake" (gratis, offline) di luar development
AI_FAKE_PROVIDER=false
