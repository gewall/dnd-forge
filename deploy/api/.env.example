# ~/apps/dnd-forge-api/.env di VPS (chmod 600). Jangan commit file .env asli.
APP_ENV=production
LOG_LEVEL=info
PUBLIC_BASE_URL=https://api-dnd.gewall.my.id

# Dari: ~/infra/postgres/new-db.sh dnd_forge
DATABASE_URL=postgres://dnd_forge:CHANGE_ME@postgres:5432/dnd_forge
MIGRATE_ON_START=true

# Dari: docker run --rm --entrypoint /app/tools ghcr.io/gewall/dnd-forge-api:latest gen-keys
INTERNAL_API_KEY=
JWT_PRIVATE_KEY=
JWT_ISSUER=dnd-forge-api
JWT_AUDIENCE=dnd-forge-web

ADMIN_EMAILS=admin@example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Garage: key dari `garage key create dnd-forge-key`
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=https://s3.gewall.my.id
S3_REGION=garage
S3_BUCKET=dnd-forge
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PRESIGN_TTL=6h
